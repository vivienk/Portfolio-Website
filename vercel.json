{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/arro", "destination": "/arro-testing-system", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/([a-f0-9]{16}-.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
